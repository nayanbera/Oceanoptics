# MCA-compatible records backed by pydev — no drvSoftMca required.
# Record names use underscores; alias() maps the dotted names that CA
# clients expect (e.g. MCA1.ERTM -> MCA1_ERTM).
#
# Load with:
#   dbLoadRecords "db/OceanopticsMCA_pydev.db", "P=15ID,D=UVVis,NROI=8,NPIX=1044"

# ------------------------------------------------------------------
# Spectrum waveform  (MCA1.VAL)
# ------------------------------------------------------------------
record(waveform, "$(P):$(D):MCA1")
{
    field(DESC, "MCA spectrum")
    field(DTYP, "pydev")
    field(INP,  "@get_spectrum()")
    field(SCAN, "Passive")
    field(NELM, "$(NPIX=1044)")
    field(FTVL, "DOUBLE")
}

# ------------------------------------------------------------------
# Status records  (MCA1.ERTM / .ELTM / .ACQG)
# ------------------------------------------------------------------
record(ai, "$(P):$(D):MCA1_ERTM")
{
    field(DESC, "Elapsed real time")
    field(DTYP, "pydev")
    field(INP,  "@mca_get_ertm()")
    field(SCAN, "Passive")
    field(EGU,  "s")
    field(PREC, "3")
}

record(ai, "$(P):$(D):MCA1_ELTM")
{
    field(DESC, "Elapsed live time")
    field(DTYP, "pydev")
    field(INP,  "@mca_get_eltm()")
    field(SCAN, "Passive")
    field(EGU,  "s")
    field(PREC, "3")
}

record(bi, "$(P):$(D):MCA1_ACQG")
{
    field(DESC, "Acquiring")
    field(DTYP, "pydev")
    field(INP,  "@mca_get_acqg()")
    field(SCAN, "Passive")
    field(ZNAM, "Done")
    field(ONAM, "Acquiring")
}

# ------------------------------------------------------------------
# Energy calibration  (MCA1.CALO / .CALS)
# ------------------------------------------------------------------
record(ao, "$(P):$(D):MCA1_CALO")
{
    field(DESC, "Energy cal offset (eV at ch 0)")
    field(DTYP, "pydev")
    field(OUT,  "@mca_set_calo(VAL)")
    field(VAL,  "0.0")
    field(PINI, "YES")
    field(EGU,  "eV")
    field(PREC, "4")
}

record(ao, "$(P):$(D):MCA1_CALS")
{
    field(DESC, "Energy cal slope (eV/ch)")
    field(DTYP, "pydev")
    field(OUT,  "@mca_set_cals(VAL)")
    field(VAL,  "1.0")
    field(PINI, "YES")
    field(EGU,  "eV/ch")
    field(PREC, "6")
}

# ------------------------------------------------------------------
# ROI 0  (MCA1.R0 / .R0LO / .R0HI / .R0NM)
# ------------------------------------------------------------------
record(ai, "$(P):$(D):MCA1_R0")
{
    field(DTYP, "pydev")
    field(INP,  "@mca_get_roi_counts(0)")
    field(SCAN, "Passive")
    field(PREC, "0")
}

record(longout, "$(P):$(D):MCA1_R0LO")
{
    field(DTYP, "pydev")
    field(OUT,  "@mca_set_roi_lo(0,VAL)")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(longout, "$(P):$(D):MCA1_R0HI")
{
    field(DTYP, "pydev")
    field(OUT,  "@mca_set_roi_hi(0,VAL)")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(stringout, "$(P):$(D):MCA1_R0NM")
{
    field(DTYP, "pydev")
    field(OUT,  "@mca_set_roi_name(0,VAL)")
    field(VAL,  "ROI 0")
    field(PINI, "YES")
}

