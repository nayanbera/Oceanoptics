#Database for Oceanoptics Spectrometer

record(longin, "$(P):$(D):IntegrationTime")
{
    field(DTYP, "pydev")
    field(INP, "@get_integration_time()")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(EGU, "usec")
}

record(longout,"$(P):$(D):setIntegrationTime")
{
    field(DTYP, "pydev")
    field(OUT, "@set_integration_time(VAL)")
    field(EGU, "usec")
    field(DRVL, "8000")
    field(DRVH, "100000000")
    field(FLNK, "$(P):$(D):IntegrationTime")
}

record(longout, "$(P):$(D):setScanNum")
{
    field(DTYP, "pydev")
    field(OUT, "@set_scans_to_average(VAL)")
    field(DRVL, "0")
    field(DRVH, "10000")
    field(FLNK, "$(P):$(D):ScanNum")
}

record(longin, "$(P):$(D):ScanNum")
{
    field(DTYP, "pydev")
    field(INP, "@get_scans_to_average()")
    field(SCAN, "Passive")
    field(PINI, "YES")
}

record(bo, "$(P):$(D):Lamp")
{
    field(DTYP, "pydev")
    field(OUT, "@lamp_on(VAL)")
    field(ONAM, "True")
    field(ZNAM, "False")
    field(FLNK, "$(P):$(D):LampStatus")
}

# NOTE: this reads adv.get_enable_lamp(), i.e. the Lamp Enable line. It
# reports what was last COMMANDED, not what either lamp is doing. The real
# lamp state is D2_STATUS / HAL_STATUS below.
record(bi, "$(P):$(D):LampStatus")
{
    field(DTYP, "pydev")
    field(INP, "@get_lamp_status()")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(ONAM, "True")
    field(ZNAM, "False")
}


