    field(DTYP, "pydev")
    field(SIZV, "256")
    field(INP,  "@hdf_get_attr_sample_desc()")
    field(SCAN, "Passive")
}

record(ao, "$(P):$(D):HDF1:Attr:BeamEnergy")
{
    field(DESC, "Beam energy in keV (written to HDF5)")
    field(DTYP, "pydev")
    field(OUT,  "@hdf_set_attr_beam_energy(VAL)")
    field(EGU,  "keV")
    field(PREC, "4")
    field(DRVL, "0")
    field(DRVH, "100")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(ai, "$(P):$(D):HDF1:Attr:BeamEnergy_RBV")
{
    field(DESC, "Beam energy readback")
    field(DTYP, "pydev")
    field(INP,  "@hdf_get_attr_beam_energy()")
    field(EGU,  "keV")
    field(PREC, "4")
    field(SCAN, "Passive")
}

record(lso, "$(P):$(D):HDF1:Attr:ExposureMode")
{
    field(DESC, "Exposure mode (written to HDF5)")
    field(DTYP, "pydev")
    field(SIZV, "64")
    field(OUT,  "@hdf_set_attr_exposure_mode(VAL)")
    field(SCAN, "Passive")
    field(PINI, "YES")
}

record(lsi, "$(P):$(D):HDF1:Attr:ExposureMode_RBV")
{
    field(DESC, "Exposure mode readback")
    field(DTYP, "pydev")
    field(SIZV, "64")
    field(INP,  "@hdf_get_attr_exposure_mode()")
    field(SCAN, "Passive")
}
