# ------------------------------------------------------------------
# NDAttributes: user-settable metadata injected into every HDF5 file
# ------------------------------------------------------------------

record(lso, "$(P):$(D):HDF1:Attr:SampleName")
{
    field(DESC, "Sample name (written to HDF5)")
    field(DTYP, "pydev")
    field(SIZV, "256")
    field(OUT,  "@hdf_set_attr_sample_name(VAL)")
    field(SCAN, "Passive")
    field(PINI, "YES")
}

record(lsi, "$(P):$(D):HDF1:Attr:SampleName_RBV")
{
    field(DESC, "Sample name readback")
    field(DTYP, "pydev")
    field(SIZV, "256")
    field(INP,  "@hdf_get_attr_sample_name()")
    field(SCAN, "Passive")
}

record(lso, "$(P):$(D):HDF1:Attr:SampleDescription")
{
    field(DESC, "Sample description (written to HDF5)")
    field(DTYP, "pydev")
    field(SIZV, "256")
    field(OUT,  "@hdf_set_attr_sample_desc(VAL)")
    field(SCAN, "Passive")
    field(PINI, "YES")
}

record(lsi, "$(P):$(D):HDF1:Attr:SampleDescription_RBV")
{
