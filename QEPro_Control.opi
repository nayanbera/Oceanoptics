<?xml version="1.0" encoding="UTF-8"?>
<display typeId="org.csstudio.opibuilder.Display" version="1.0.0">
  <auto_scale_widgets>
    <auto_scale_widgets>false</auto_scale_widgets>
    <min_width>-1</min_width>
    <min_height>-1</min_height>
  </auto_scale_widgets>
  <height>950</height>
  <width>1100</width>
  <bg_color><color red="240" green="240" blue="240"/></bg_color>
  <show_grid>false</show_grid>
  <snap_to_geometry>true</snap_to_geometry>

  <!-- ===== TITLE ===== -->
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>Title</name>
    <x>10</x><y>6</y><width>620</width><height>26</height>
    <text>QEPro UV-Vis Spectrometer  --  15ID:UVVis</text>
    <transparent>true</transparent>
    <border_style>0</border_style>
    <font><fontdata fontName="Liberation Sans" height="14" style="1"/></font>
    <foreground_color><color red="0" green="0" blue="100"/></foreground_color>
  </widget>

  <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
    <name>Message</name>
    <x>635</x><y>6</y><width>455</width><height>26</height>
    <pv_name>15ID:UVVis:Message</pv_name>
    <border_style>0</border_style>
    <transparent>true</transparent>
    <font><fontdata fontName="Liberation Sans" height="11" style="2"/></font>
    <foreground_color><color red="80" green="80" blue="80"/></foreground_color>
  </widget>

  <!-- ===== SPECTRUM XYGRAPH ===== -->
  <widget typeId="org.csstudio.opibuilder.widgets.xyGraph" version="1.0.0">
    <name>Spectrum Plot</name>
    <x>10</x><y>36</y><width>700</width><height>284</height>
    <title>Spectra</title>
    <show_toolbar>true</show_toolbar>
    <axis_0_axis_title>Wavelength (nm)</axis_0_axis_title>
    <axis_0_auto_scale>true</axis_0_auto_scale>
    <axis_0_show_grid>true</axis_0_show_grid>
    <axis_1_axis_title>Intensity (counts)</axis_1_axis_title>
    <axis_1_auto_scale>true</axis_1_auto_scale>
    <axis_1_show_grid>true</axis_1_show_grid>
    <trace_count>4</trace_count>
    <trace_0_name>Spectrum</trace_0_name>
    <trace_0_x_pv>15ID:UVVis:Wavelengths</trace_0_x_pv>
    <trace_0_y_pv>15ID:UVVis:Spectrum</trace_0_y_pv>
    <trace_0_trace_color><color red="21" green="21" blue="196"/></trace_0_trace_color>
    <trace_0_line_width>2</trace_0_line_width>
    <trace_0_trace_type>0</trace_0_trace_type>
    <trace_1_name>Dark</trace_1_name>
    <trace_1_x_pv>15ID:UVVis:Wavelengths</trace_1_x_pv>
    <trace_1_y_pv>15ID:UVVis:DarkSpectrum</trace_1_y_pv>
    <trace_1_trace_color><color red="80" green="80" blue="80"/></trace_1_trace_color>
    <trace_1_line_width>1</trace_1_line_width>
    <trace_1_trace_type>0</trace_1_trace_type>
    <trace_2_name>Reference</trace_2_name>
    <trace_2_x_pv>15ID:UVVis:Wavelengths</trace_2_x_pv>
    <trace_2_y_pv>15ID:UVVis:ReferenceSpectrum</trace_2_y_pv>
    <trace_2_trace_color><color red="200" green="100" blue="0"/></trace_2_trace_color>
    <trace_2_line_width>1</trace_2_line_width>
    <trace_2_trace_type>0</trace_2_trace_type>
    <trace_3_name>UV-Vis Abs</trace_3_name>
    <trace_3_x_pv>15ID:UVVis:Wavelengths</trace_3_x_pv>
    <trace_3_y_pv>15ID:UVVis:UVVis</trace_3_y_pv>
    <trace_3_trace_color><color red="0" green="160" blue="0"/></trace_3_trace_color>
    <trace_3_line_width>2</trace_3_line_width>
    <trace_3_trace_type>0</trace_3_trace_type>
    <trace_3_visible>false</trace_3_visible>
    <border_style>0</border_style>
  </widget>

