               type="EPICS_PV"
               source="ID15ds:Energy.VAL"
               dbrtype="DBR_DOUBLE"
               description="Undulator gap energy (keV)" />
    -->

    <!-- ── Monochromator ─────────────────────────────────────────── -->
    <!--
