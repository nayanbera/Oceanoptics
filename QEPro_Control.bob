<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>QEPro Spectrometer Control</name>
  <width>1100</width>
  <height>950</height>
  <background_color><color red="240" green="240" blue="240" alpha="255"/></background_color>

  <!-- ===== TITLE ===== -->
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <x>10</x><y>6</y><width>620</width><height>26</height>
    <text>QEPro UV-Vis Spectrometer — 15ID:UVVis</text>
    <font><font family="Liberation Sans" style="BOLD" size="14"/></font>
    <foreground_color><color red="0" green="0" blue="100" alpha="255"/></foreground_color>
  </widget>
  <widget type="text_update" version="1.0.0">
    <name>Message</name>
    <x>635</x><y>6</y><width>455</width><height>26</height>
    <pv_name>15ID:UVVis:Message</pv_name>
    <font><font family="Liberation Sans" style="ITALIC" size="11"/></font>
    <foreground_color><color red="80" green="80" blue="80" alpha="255"/></foreground_color>
  </widget>

  <!-- ===== SPECTRUM PLOT ===== -->
  <widget type="xy_plot" version="1.0.0">
    <name>Spectrum Plot</name>
    <x>10</x><y>36</y><width>700</width><height>284</height>
    <title>Spectra</title>
    <show_toolbar>true</show_toolbar>
    <x_axis>
      <title>Wavelength (nm)</title>
      <autoscale>true</autoscale>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Intensity (counts)</title>
        <autoscale>true</autoscale>
        <index>0</index>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>Spectrum</name>
        <x_pv>15ID:UVVis:Wavelengths</x_pv>
        <y_pv>15ID:UVVis:Spectrum</y_pv>
        <color><color red="21" green="21" blue="196" alpha="255"/></color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <y_axis>0</y_axis>
      </trace>
      <trace>
        <name>Dark</name>
        <x_pv>15ID:UVVis:Wavelengths</x_pv>
        <y_pv>15ID:UVVis:DarkSpectrum</y_pv>
        <color><color red="80" green="80" blue="80" alpha="255"/></color>
        <line_width>1</line_width>
        <point_type>0</point_type>
        <y_axis>0</y_axis>
      </trace>
      <trace>
        <name>Reference</name>
        <x_pv>15ID:UVVis:Wavelengths</x_pv>
        <y_pv>15ID:UVVis:ReferenceSpectrum</y_pv>
        <color><color red="200" green="100" blue="0" alpha="255"/></color>
        <line_width>1</line_width>
        <point_type>0</point_type>
        <y_axis>0</y_axis>
      </trace>
      <trace>
        <name>UV-Vis Abs</name>
        <x_pv>15ID:UVVis:Wavelengths</x_pv>
        <y_pv>15ID:UVVis:UVVis</y_pv>
        <color><color red="0" green="160" blue="0" alpha="255"/></color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <y_axis>0</y_axis>
      </trace>
    </traces>
  </widget>

  <!-- ===== TEC SECTION (x=720, y=36, w=370, h=135) ===== -->
  <widget type="rectangle" version="2.0.0">
    <name>TEC Rect</name>
